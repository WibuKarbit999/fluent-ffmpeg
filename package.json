{
  "name": "fluent-ffmpeg",
  "version": "1.0.1",
  "description": "A fluent API to FFMPEG (http://www.ffmpeg.org) — modern ESM fork",
  "author": {
    "name": "WibuKarbit999",
    "url": "https://github.com/WibuKarbit999"
  },
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "index.js",
    "index.d.ts"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "NODE_ENV=test mocha --require should --reporter spec",
    "test:coverage": "NODE_ENV=test nyc mocha --require should --reporter spec",
    "docs": "jsdoc -c tools/jsdoc-conf.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WibuKarbit999/fluent-ffmpeg.git"
  },
  "dependencies": {
    "async": "^3.2.6",
    "which": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "jsdoc": "^4.0.4",
    "mocha": "^10.8.2",
    "nyc": "^17.1.0",
    "should": "^13.2.3"
  }
}
